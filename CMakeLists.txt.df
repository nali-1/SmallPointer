cmake_minimum_required(VERSION 3.31)

#//.i system
#set(ST linux)
#set(ST android)
#set(ST win)

#//.i surface
#set(DRM 1)
#set(AWINDOW 1)
#set(WL 1)
#set(X11 1)

#//.i run
#set(GEN 1)
#set(CLIENT 1)
#set(SERVER 1)

#//.i media reader
#set(FFMPEG 1)

#//.i network protocol
#set(UDP 1)
#set(TCP 1)

#//.i audio
#set(PIPEWIRE 1)
#set(ALSA 1)
#set(AAUDIO 1)
#set(OPENAL 1)

#//.i render
#set(VK 1)
#  set(VK_DEBUG_UTILS 1)
#  set(VK_DEBUG_REPORT 1)
#set(GL 1)
#  set(GL_DEBUG 1)

#//.i input
#set(LIBINPUT 1)
#set(WLINPUT 1)
#set(X11INPUT 1)
#set(AINPUT 1)

#set(TEST 1)
#set(DEBUG 1)

set(PN SmallPointer)
project(${PN} LANGUAGES C)

file(GLOB_RECURSE G_SOURCES c/file/*.c)
list(APPEND SOURCES ${G_SOURCES})

set(TLL m)
file(GLOB_RECURSE G_SOURCES c/math/*.c)
list(APPEND SOURCES ${G_SOURCES})

if(TEST)
  list(APPEND TCD SMPT_CM_TEST)
endif()

if(DEBUG)
  list(APPEND TCD SMPT_CM_DEBUG)

  list(APPEND SOURCES c/debug/debug.c)
endif()

if(GEN)
  list(APPEND TCD SMPT_CM_GEN)

  file(GLOB_RECURSE G_SOURCES c/gen/*.c)
  list(APPEND SOURCES ${G_SOURCES})

  list(APPEND TID ../cgltf)
endif()

list(APPEND SOURCES c/smpt.c)
list(APPEND SOURCES c/raw/keyframe/keyframe.c)
list(APPEND SOURCES c/raw/model/model.c)
list(APPEND SOURCES c/raw/raw.c)
list(APPEND SOURCES c/audio/audio.c)
list(APPEND SOURCES c/network/network.c)

if(DRM OR AWINDOW OR WL OR X11)
  list(APPEND SOURCES c/surface/surface.c)
endif()

if(CLIENT)
  list(APPEND TCD SMPT_CM_CLIENT)

  file(GLOB_RECURSE G_SOURCES c/raw/client/*.c)
  list(APPEND SOURCES ${G_SOURCES})
endif()

if(SERVER)
  list(APPEND TCD SMPT_CM_SERVER)

  file(GLOB_RECURSE G_SOURCES c/raw/server/*.c)
  list(APPEND SOURCES ${G_SOURCES})
endif()

if(FFMPEG)
  list(APPEND TCD SMPT_CM_FFMPEG)

  if(ST STREQUAL "linux")
    list(APPEND TLL
      avcodec
      avformat
      avutil
      swresample
    )
  elseif(ST STREQUAL "android")
    list(APPEND TID ../FFmpeg/android/arm64/include)
    list(APPEND TLL
      ${CMAKE_SOURCE_DIR}/../FFmpeg/android/arm64/lib/libavcodec.so
      ${CMAKE_SOURCE_DIR}/../FFmpeg/android/arm64/lib/libavformat.so
      ${CMAKE_SOURCE_DIR}/../FFmpeg/android/arm64/lib/libavutil.so

      ${CMAKE_SOURCE_DIR}/../FFmpeg/android/arm64/lib/libswresample.so
    )
  endif()

  list(APPEND SOURCES c/ffmpeg/ffmpeg.c)
endif()

if(UDP)
  list(APPEND TCD SMPT_CM_UDP)

  if(CLIENT)
    list(APPEND SOURCES c/network/udp/client/client.c)
  endif()
  if(SERVER)
    list(APPEND SOURCES c/network/udp/server/server.c)
  endif()
elseif(TCP)
  list(APPEND TCD SMPT_CM_TCP)

  if(CLIENT)
    list(APPEND SOURCES c/network/tcp/client/client.c)
  endif()
  if(SERVER)
    list(APPEND SOURCES c/network/tcp/server/server.c)
  endif()
endif()

if(VK)
  list(APPEND TCD SMPT_CM_VK)

  if(ST STREQUAL "linux")
    list(APPEND TLL vulkan)
  elseif(ST STREQUAL "android")
    list(APPEND TLL ${CMAKE_SOURCE_DIR}/../android-ndk-r27d/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/aarch64-linux-android/32/libvulkan.so)
  endif()

  file(GLOB_RECURSE G_SOURCES c/render/vk/*.c)
  list(APPEND SOURCES ${G_SOURCES})

  if(VK_DEBUG_UTILS)
    list(APPEND TCD SMPT_CM_VK_DEBUG_UTILS)
    list(APPEND SOURCES c/render/vk/debug/debug.c)
    if(ST STREQUAL "android")
      list(APPEND TLL ${CMAKE_SOURCE_DIR}/../android-binaries-1.4.335.0/arm64-v8a/libVkLayer_khronos_validation.so)
    endif()
  endif()
  if(VK_DEBUG_REPORT)
    list(APPEND TCD SMPT_CM_VK_DEBUG_REPORT)
    list(APPEND SOURCES c/render/vk/debug/debug.c)
    if(ST STREQUAL "android")
      list(APPEND TLL ${CMAKE_SOURCE_DIR}/../android-binaries-1.4.335.0/arm64-v8a/libVkLayer_khronos_validation.so)
    endif()
  endif()
endif()
if(GL)
  list(APPEND TCD SMPT_CM_GL)

  file(GLOB_RECURSE G_SOURCES c/render/gl/*.c)
  list(APPEND SOURCES ${G_SOURCES})

  if(GL_DEBUG)
    list(APPEND TCD SMPT_CM_GL_DEBUG)
  endif()
endif()

if(ST STREQUAL "linux")
  list(APPEND TCD SMPT_CM_ST_LINUX)

  if(DRM)
    list(APPEND TCD SMPT_CM_DRM)
  endif()

  if(LIBINPUT)
    list(APPEND TCD SMPT_CM_LIBINPUT)

    file(GLOB_RECURSE G_SOURCES c/input/libinput/*.c)
    list(APPEND SOURCES ${G_SOURCES})

    list(APPEND TLL
      input
      udev
    )
  endif()

#  if(PIPEWIRE)
#    list(APPEND TLL pipewire-0.3)
#    list(APPEND TID /usr/include/spa-0.2)
#    list(APPEND TID /usr/include/pipewire-0.3)
#
#    file(GLOB_RECURSE G_SOURCES c/audio/pipewire/*.c)
#    list(APPEND SOURCES ${G_SOURCES})
#  endif()
  if(ALSA)
    list(APPEND TCD SMPT_CM_ALSA)

    list(APPEND TLL asound)

    file(GLOB_RECURSE G_SOURCES c/audio/alsa/*.c)
    list(APPEND SOURCES ${G_SOURCES})
  endif()

  if(WL)
    list(APPEND TCD SMPT_CM_WL)

    if(WLINPUT)
      list(APPEND TCD SMPT_CM_WLINPUT)
    endif()

    list(APPEND TLL
      wayland-client
      wayland-cursor
    )

    file(GLOB_RECURSE G_SOURCES lib/wayland/*.c)
    list(APPEND SOURCES ${G_SOURCES})

    file(GLOB_RECURSE G_SOURCES c/surface/wayland/*.c)
    list(APPEND SOURCES ${G_SOURCES})

    list(APPEND TID lib/wayland)
  endif()

  add_executable(${PN} ${SOURCES})
elseif(ST STREQUAL "android")
  list(APPEND TCD SMPT_CM_ST_ANDROID)

  #//! audio android
  list(APPEND TLL
    android
    #OpenSLES
  )

  if(AAUDIO)
    list(APPEND TCD SMPT_CM_AAUDIO)

    list(APPEND TLL
      aaudio
    )

    file(GLOB_RECURSE G_SOURCES c/audio/aaudio/*.c)
    list(APPEND SOURCES ${G_SOURCES})
  endif()

  if(AWINDOW)
    list(APPEND TCD SMPT_CM_AWINDOW)

    file(GLOB_RECURSE G_SOURCES c/surface/awindow/*.c)
    list(APPEND SOURCES ${G_SOURCES})
  endif()

  if(AINPUT)
    list(APPEND TCD SMPT_CM_AINPUT)

    file(GLOB_RECURSE G_SOURCES c/input/ainput/*.c)
    list(APPEND SOURCES ${G_SOURCES})
  endif()

  add_library(${PN} SHARED ${SOURCES})
endif()

if(TID)
  target_include_directories(${PN} PRIVATE ${TID})
endif()
target_link_libraries(${PN} ${TLL})
target_compile_definitions(${PN} PRIVATE ${TCD})

target_precompile_headers(${PN} PRIVATE c/smpt.h)
