DIR0=$(cd -- $(dirname -- $0) && pwd)
cd $DIR0/..
run/config
F=CMakeLists.txt
sed -i '/#set(SMPT_LINUX 1)/c\set(SMPT_LINUX 1)' $F

while true; do
	echo '1)MAIN'
	echo '2)NONE'
	read i
