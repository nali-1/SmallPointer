DIR0=$(cd -- $(dirname -- $0) && pwd)
cd $DIR0/..
../android-ndk-r27d/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip build-release/libSmallPointer.so
../build-tools/35.0.0/aapt2 link \
	-o build-release/smallpointer.apk \
	-I ../platforms/android-32/android.jar \
	--manifest AndroidManifest.xml \
	-A asset
mkdir -p apk/lib/arm64-v8a
cp build-release/libSmallPointer.so apk/lib/arm64-v8a
cp ../android-binaries-1.4.335.0/arm64-v8a/libVkLayer_khronos_validation.so apk/lib/arm64-v8a
cp ../FFmpeg/android/arm64/lib/libavcodec.so apk/lib/arm64-v8a
cp ../FFmpeg/android/arm64/lib/libavformat.so apk/lib/arm64-v8a
cp ../FFmpeg/android/arm64/lib/libavutil.so apk/lib/arm64-v8a
cp ../FFmpeg/android/arm64/lib/libswresample.so apk/lib/arm64-v8a
cd apk
zip -r ../build-release/smallpointer.apk lib
cd ..
keytool -genkeypair \
	-alias androiddebugkey \
	-keypass android \
	-keystore build-release/.keystore \
	-storepass android \
	-dname "CN=Android Debug,O=Android,C=US" \
	-keyalg RSA \
	-keysize 2048 \
	-validity 10000
../build-tools/35.0.0/zipalign -p -f 4 build-release/smallpointer.apk build-release/smallpointer-aligned.apk
../build-tools/35.0.0/apksigner sign --ks build-release/.keystore \
	--ks-pass pass:android \
	--key-pass pass:android \
	--ks-key-alias androiddebugkey \
	build-release/smallpointer-aligned.apk
adb shell pm uninstall --user 0 com.nali.smallpointer
adb install build-release/smallpointer-aligned.apk
