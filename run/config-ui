DIR0=$(cd -- $(dirname -- $0) && pwd)
cd $DIR0/..
run/config
F=CMakeLists.txt
sed -i '/#set(UI 1)/c\set(UI 1)' $F

while true; do
	echo '1)LINUX'
	echo '2)NONE'
	read i
	if [ $i = 1 ]; then
		sed -i '/#set(SMPT_LINUX 1)/c\set(SMPT_LINUX 1)' $F
		break
	elif [ $i = 2 ]; then
		break
	fi
done

