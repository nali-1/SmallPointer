sed -i '/#set(VK 1)/c\set(VK 1)' $F
while true; do
	echo '1)VK_DEBUG_UTILS'
	echo '2)VK_DEBUG_REPORT'
	echo '3)NONE'
	read i
	if [ $i = 1 ]; then
		sed -i '/#  set(VK_DEBUG_UTILS 1)/c\  set(VK_DEBUG_UTILS 1)' $F
		break
