DIR0=$(cd -- $(dirname -- $0) && pwd)
cd $DIR0/..
run/config
F=CMakeLists.txt
sed -i '/#set(ST android)/c\set(ST android)' $F

sed -i '/#set(MAIN 1)/c\set(MAIN 1)' $F

sed -i '/#set(AWINDOW 1)/c\set(AWINDOW 1)' $F
sed -i '/#set(AINPUT 1)/c\set(AINPUT 1)' $F

S=0
while true; do
	echo '1)CLIENT'
	echo '2)NONE'
	read i
	if [ $i = 1 ]; then
		sed -i '/#set(CLIENT 1)/c\set(CLIENT 1)' $F
		break
	elif [ $i = 2 ]; then
		sed -i '/#set(SERVER 1)/c\set(SERVER 1)' $F
		S=1
		break
	fi
done

if [ $S = 0 ]; then
	while true; do
		echo '1)SERVER'
		echo '2)NONE'
		read i
		if [ $i = 1 ]; then
			sed -i '/#set(SERVER 1)/c\set(SERVER 1)' $F
			break
		elif [ $i = 2 ]; then
			break
		fi
	done
fi

#sed -i '/#set(FFMPEG 1)/c\set(FFMPEG 1)' $F
#run/android-ffmpeg
sed -i '/#set(UDP 1)/c\set(UDP 1)' $F

while true; do
	echo '1)AAUDIO'
	echo '2)NONE'
